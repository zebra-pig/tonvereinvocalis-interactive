{
  "name": "tonvereinvocalis-interactive",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "perf": "node scripts/perf.ts",
    "flyer": "for s in front back; do sips -Z 1754 -m \"/System/Library/ColorSync/Profiles/sRGB Profile.icc\" -s format jpeg -s formatOptions 80 ~/Desktop/vocalis-flyer/flyer-${s}_1.jpg --out src/assets/flyer-$s.jpg; done"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/three": "0.185.4",
    "lil-gui": "^0.21.0",
    "playwright": "^1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.0"
  },
  "dependencies": {
    "three": "0.185.1"
  }
}
